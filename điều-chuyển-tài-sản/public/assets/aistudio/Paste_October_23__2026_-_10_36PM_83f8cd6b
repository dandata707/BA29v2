<script>
  (function initTransferReviewUI() {
    const textarea = document.getElementById('review-notes');
    const counter = document.getElementById('char-counter');
    const toast = document.getElementById('toast-notify');
    const toastMsg = document.getElementById('toast-message');
    const toastIcon = document.getElementById('toast-icon');

    // Real-time character counter
    if (textarea && counter) {
      textarea.addEventListener('input', (e) => {
        const len = e.target.value.length;
        counter.textContent = `${len}/500 ký tự`;
      });
    }

    function showToast(message, iconName = 'check_circle') {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      if (toastIcon) toastIcon.textContent = iconName;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }

    // Action buttons interaction mock
    const btnApprove = document.getElementById('btn-approve');
    const btnReject = document.getElementById('btn-reject');
    const btnRequestMore = document.getElementById('btn-request-more');
    const conditionCheck = document.getElementById('condition-checkbox');

    if (btnApprove) {
      btnApprove.addEventListener('click', () => {
        if (conditionCheck && !conditionCheck.checked) {
          showToast('Vui lòng tích xác nhận "Tài sản đủ điều kiện điều chuyển" trước khi duyệt!', 'warning');
          conditionCheck.focus();
          return;
        }
        showToast('Yêu cầu DC-2026-0012 đã được phê duyệt thành công!', 'task_alt');
      });
    }

    if (btnReject) {
      btnReject.addEventListener('click', () => {
        const notes = textarea ? textarea.value.trim() : '';
        if (!notes) {
          showToast('Vui lòng nhập lý do từ chối vào ô ghi chú kiểm tra!', 'error');
          if (textarea) textarea.focus();
          return;
        }
        showToast('Yêu cầu DC-2026-0012 đã bị từ chối chuyển giao.', 'block');
      });
    }

    if (btnRequestMore) {
      btnRequestMore.addEventListener('click', () => {
        const notes = textarea ? textarea.value.trim() : '';
        if (!notes) {
          showToast('Vui lòng nêu rõ các giấy tờ hoặc hạng mục cần bổ sung!', 'info');
          if (textarea) textarea.focus();
          return;
        }
        showToast('Đã gửi thông báo yêu cầu bổ sung hồ sơ tới người đề nghị.', 'send');
      });
    }
  })();
