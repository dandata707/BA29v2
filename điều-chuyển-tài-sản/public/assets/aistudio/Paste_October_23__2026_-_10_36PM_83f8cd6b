<script>
  // Simple dropdown toggle & filter micro-interaction
  const filterBtn = document.getElementById('status-filter-btn');
  const dropdown = document.getElementById('status-dropdown');
  const filterLabel = document.getElementById('current-filter-label');
  const searchInput = document.getElementById('asset-transfer-search');
  const cardsContainer = document.getElementById('transfer-cards-list');

  if (filterBtn && dropdown) {
    filterBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      if (!dropdown.classList.contains('hidden')) {
        dropdown.classList.add('hidden');
      }
    });

    dropdown.querySelectorAll('button').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const text = btn.querySelector('span:first-child')?.innerText || btn.innerText;
        filterLabel.innerText = text.includes('Tất cả') ? 'Trạng thái: Tất cả' : 'Trạng thái: ' + text;
        dropdown.classList.add('hidden');
      });
    });
  }

  // Live search filtering simulation
  if (searchInput && cardsContainer) {
    searchInput.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      const cards = cardsContainer.children;
      for (let i = 0; i < cards.length; i++) {
        const text = cards[i].innerText.toLowerCase();
        if (text.includes(term)) {
          cards[i].style.display = 'block';
        } else {
          cards[i].style.display = 'none';
        }
      }
    });
  }
</script></main></div></div></div>

